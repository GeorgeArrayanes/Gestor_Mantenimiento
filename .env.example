# Backend
PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.TU_PROJECT_REF.supabase.co:5432/postgres
DATABASE_SSL=true
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=8h
FRONTEND_URL=http://localhost:5173
MAX_FILE_SIZE_MB=5

# Supabase Storage (recommended outside local development)
SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=rutasegura-evidencias
SUPER_ADMIN_EMAIL=Admin@gla.edu.co
# Obligatoria al ejecutar db:seed sobre una base persistente. Déjala fuera del repositorio.
SUPER_ADMIN_PASSWORD=

# Local development only. Uses a temporary PostgreSQL-compatible database
# so the demo can run without installing PostgreSQL.
DEV_MEMORY_DB=false

# Frontend
VITE_API_URL=http://localhost:4000/api
