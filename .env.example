# Backend — use a dedicated Maintenance database
PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5433/mantenimiento
DATABASE_SSL=false
POSTGRES_PASSWORD=
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=8h
FRONTEND_URL=http://localhost:5173
MAX_FILE_SIZE_MB=5

# Optional private Supabase Storage. Leave both blank for local storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=mantenimiento-evidencias
SUPER_ADMIN_EMAIL=Admin@gla.edu.co
SUPER_ADMIN_PASSWORD=

# Explicit, temporary demo only. Never enable in production.
DEV_MEMORY_DB=false

# Same-origin /api by default; set only for a separate API deployment.
VITE_API_URL=
